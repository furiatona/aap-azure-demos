<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Azure storage visibility</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; margin: 2rem; line-height: 1.4; }
    h1 { font-size: 1.35rem; }
    table { border-collapse: collapse; width: 100%; max-width: 1100px; margin-top: 1rem; }
    th, td { border: 1px solid #ccc; padding: 0.45rem 0.65rem; text-align: left; vertical-align: top; }
    th { background: #f0f0f0; font-weight: 600; }
    caption { text-align: left; font-weight: 600; margin: 0 0 0.5rem; }
    .meta { color: #444; font-size: 0.9rem; margin-bottom: 0.25rem; }
    td.mono { font-family: ui-monospace, monospace; font-size: 0.82rem; word-break: break-all; }
    a { color: #0066b8; }
  </style>
</head>
<body>
  <h1>Azure storage visibility</h1>
  <p class="meta">Resource group: {{ azure_visibility_resource_group_name }}</p>
  <p class="meta">Generated: {{ ansible_date_time.date | default('') }} {{ ansible_date_time.time | default('') }} (controller time)</p>
  <table>
    <caption>Storage accounts in scope</caption>
    <thead>
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>SKU</th>
        <th>Kind</th>
        <th>Access tier</th>
        <th>Blob endpoint</th>
      </tr>
    </thead>
    <tbody>
{% for a in azure_visibility_storage_accounts %}
{% set sku = a.sku.name | default(a.account_type | default('', true), true) %}
{% set tier = a.access_tier | default(a.accessTier | default('', true), true) %}
{% set pe = a.primary_endpoints | default(a.primaryEndpoints | default({}, true), true) %}
{% set blob_ep = (pe.blob | default(pe['blob'] | default('', true), true)) if pe else '' %}
      <tr>
        <td>{{ a.name | default('', true) }}</td>
        <td>{{ a.location | default('', true) }}</td>
        <td>{{ sku }}</td>
        <td>{{ a.kind | default('', true) }}</td>
        <td>{{ tier }}</td>
        <td class="mono">{% if blob_ep %}<a href="{{ blob_ep }}">{{ blob_ep }}</a>{% endif %}</td>
      </tr>
{% else %}
      <tr><td colspan="6">No storage accounts returned for this resource group.</td></tr>
{% endfor %}
    </tbody>
  </table>
</body>
</html>
